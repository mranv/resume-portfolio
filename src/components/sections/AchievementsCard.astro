---
import Card from '../Card.astro'
import { Trophy, Award, Star, Target } from 'lucide-react'
---

<Card colSpan="col-span-1 md:col-span-2 lg:col-span-1">
  <div class="flex flex-col gap-4">
    <div>
      <h3 class="text-2xl font-bold mb-2">Achievements</h3>
      <div class="w-16 h-1 bg-gradient-to-r from-primary to-accent rounded-full"></div>
    </div>
    <div class="space-y-3">
      <div class="flex items-start gap-3">
        <Trophy className="h-5 w-5 text-cyber-purple mt-0.5 flex-shrink-0" />
        <div>
          <p class="text-sm font-medium">DevSecOps Excellence</p>
          <p class="text-xs text-muted-foreground">Reduced security vulnerabilities by 40% through automated CI/CD pipelines</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <Award className="h-5 w-5 text-cyber-blue mt-0.5 flex-shrink-0" />
        <div>
          <p class="text-sm font-medium">Security Architecture Leadership</p>
          <p class="text-xs text-muted-foreground">Designed enterprise security solutions for Infopercept's Invinsense platform</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <Star className="h-5 w-5 text-cyber-teal mt-0.5 flex-shrink-0" />
        <div>
          <p class="text-sm font-medium">Incident Response Expert</p>
          <p class="text-xs text-muted-foreground">50% reduction in security incident resolution time at Parul University</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <Target className="h-5 w-5 text-cyber-green mt-0.5 flex-shrink-0" />
        <div>
          <p class="text-sm font-medium">Cross-Team Collaboration</p>
          <p class="text-xs text-muted-foreground">25% reduction in security incidents through DevSecOps culture implementation</p>
        </div>
      </div>
    </div>
  </div>
</Card>