---
import Card from '../Card.astro'
import Pulse from '../Pulse.astro'
---
<Card colSpan="col-span-1">
  <div class="flex flex-col gap-4">
    <div class="flex w-full items-start justify-between">
      <div>
        <h3 class="text-2xl font-bold mb-2">Now</h3>
        <div class="w-16 h-1 bg-gradient-to-r from-primary to-accent rounded-full mb-2"></div>
        <a href="https://sive.rs/nowff" target="_blank">
          <span class="cursor-pointer text-xs text-muted-foreground hover:text-primary transition-colors">what's a now page?</span>
        </a>
      </div>
      <Pulse />
    </div>
    <div class="space-y-3">
      <div>
        <p class="text-sm font-semibold text-primary">Security Engineer @ Infopercept Consulting</p>
        <p class="text-xs text-muted-foreground">Leading XDR/OXDR platform development</p>
      </div>
      <div>
        <p class="text-sm font-semibold text-primary">CEO & Founder @ TechAnv Consulting</p>
        <p class="text-xs text-muted-foreground">Driving cybersecurity innovation and research</p>
      </div>
      <ul class="space-y-1 text-sm text-muted-foreground">
        <li class="flex items-start gap-2">
          <span class="w-1.5 h-1.5 bg-primary rounded-full mt-1.5 flex-shrink-0"></span>
          Building advanced threat detection systems with Rust
        </li>
        <li class="flex items-start gap-2">
          <span class="w-1.5 h-1.5 bg-primary rounded-full mt-1.5 flex-shrink-0"></span>
          Developing security automation solutions for enterprise clients
        </li>
        <li class="flex items-start gap-2">
          <span class="w-1.5 h-1.5 bg-primary rounded-full mt-1.5 flex-shrink-0"></span>
          Contributing to open-source security tools on GitHub
        </li>
        <li class="flex items-start gap-2">
          <span class="w-1.5 h-1.5 bg-primary rounded-full mt-1.5 flex-shrink-0"></span>
          Writing technical articles on security best practices
        </li>
      </ul>
    </div>
  </div>
</Card>