---
import Card from '../Card.astro'
import { Button } from '../ui/button'
import { LINKS } from '../../lib/constants'
import { Linkedin, Github, Mail, SquareArrowOutUpRight } from 'lucide-react'
import { Image } from 'astro:assets'
import profileImage from '/public/me.png'
---
<Card colSpan="col-span-1 md:col-span-2 lg:col-span-4">
<div class="flex h-full w-full">
<div class="flex flex-col justify-between gap-4 md:max-h-[300px]">
<div class="flex h-full flex-col">
<h6 class="m-0 text-sm font-medium uppercase tracking-wider text-primary/80">Security Professional</h6>
<h1 class="mt-2 mb-4 text-4xl font-bold tracking-tight">
 Hi, I'm <span class="gradient-text">Anubhav Gain</span>
</h1>
<p class="m-0 text-lg text-muted-foreground leading-relaxed">
 Cybersecurity Leader, Security Engineer at <span class="font-medium text-foreground">Infopercept Consulting</span>, 
 and CEO of <span class="font-medium text-foreground">TechAnv Consulting</span>. 
 I specialize in XDR/OXDR platform development, DevSecOps, and building
 robust security solutions with Rust and cloud technologies.
</p>
</div>
<div class="flex gap-3">
<a href={LINKS.github} aria-label="github profile" target="_blank">
<Button variant="outline" size="icon" className="hover:bg-primary hover:text-primary-foreground transition-all duration-300 hover:scale-105">
<Github className="h-5 w-5" />
<span class="sr-only">GitHub Profile</span>
</Button>
</a>
<a href={LINKS.linkedin} aria-label="linkedin profile" target="_blank">
<Button variant="outline" size="icon" className="hover:bg-primary hover:text-primary-foreground transition-all duration-300 hover:scale-105">
<Linkedin className="h-5 w-5" />
<span class="sr-only">Linkedin Profile</span>
</Button>
</a>
<a href={LINKS.mail} aria-label="mail profile" target="_blank">
<Button variant="outline" size="icon" className="hover:bg-primary hover:text-primary-foreground transition-all duration-300 hover:scale-105">
<Mail className="h-5 w-5" />
<span class="sr-only">Email contact</span>
</Button>
</a>
<a href="/public/CV English.pdf" download aria-label="download resume">
<Button className="gap-2">
Download Resume
<SquareArrowOutUpRight className="h-4 w-4" />
</Button>
</a>
</div>
</div>
<Image
src={profileImage}
width={300}
height={300}
class="pointer-events-none absolute bottom-[-20px] right-[-110px] z-[-1] max-h-[300px] w-auto select-none opacity-50 md:relative md:bottom-auto md:right-auto md:z-auto md:opacity-100"
alt="Anubhav Gain"
/>
</div>
</Card>