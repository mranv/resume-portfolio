---
import BaseLayout from '../layouts/BaseLayout.astro'
import IntroCard from '../components/sections/IntroCard.astro'
import AboutMe from '../components/sections/AboutMe.astro'
import Card from '../components/Card.astro'
import TimeZoneCard from '../components/sections/TimeZoneCard.astro'
import ContactsCard from '../components/sections/ContactsCard.astro'
import Now from '../components/sections/Now.astro'
import CVCard from '../components/sections/CVCard.astro'
import ExperienceCard from '../components/sections/ExperienceCard.astro'
import TattooCard from '../components/sections/TattooCard.astro'
import StudyCard from '../components/sections/StudyCard.astro'
import ProjectsCard from '../components/sections/ProjectsCard.astro'
import MyStack from '../components/sections/MyStack.astro'
import AchievementsCard from '../components/sections/AchievementsCard.astro'
import CertificationsCard from '../components/sections/CertificationsCard.astro'
import SkillsVisualization from '../components/sections/SkillsVisualization.astro'
import StatsCard from '../components/sections/StatsCard.astro'
import PhilosophyCard from '../components/sections/PhilosophyCard.astro'
---

<script>
  // Enhanced staggered animations
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('show')
        }
      })
    }, { threshold: 0.1 })

    const elements = document.querySelectorAll('[data-animate]')
    elements.forEach((el) => observer.observe(el))
  })
</script>

<style>
  [data-animate] {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  [data-animate].show {
    opacity: 1;
    transform: translateY(0);
  }
  
  @media (prefers-reduced-motion: reduce) {
    [data-animate] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<BaseLayout
  title="Anubhav Gain - Cybersecurity Leader & Security Engineer"
  description="Anubhav Gain is a Cybersecurity Leader, Security Engineer at Infopercept Consulting, and CEO at TechAnv Consulting. Specializing in XDR/OXDR platform development, Rust programming, DevSecOps, and cloud security solutions."
>
<div id="loader" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-background transition-opacity duration-500">
  <div class="relative">
    <div class="w-20 h-20 border-4 border-primary/20 rounded-full animate-pulse"></div>
    <div class="absolute top-0 left-0 w-20 h-20 border-4 border-t-primary border-r-transparent border-b-transparent border-l-transparent rounded-full animate-spin"></div>
  </div>
  <div class="mt-6 text-lg font-medium text-muted-foreground animate-pulse">
    Initializing Security Protocols...
  </div>
</div>
  <main
    class="relative m-auto grid w-full max-w-7xl gap-4 p-4 md:p-6 lg:p-8 grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-4"
  >
    <!-- Hero Section - Full Width -->
    <div class="col-span-1 md:col-span-2 lg:col-span-4" data-animate>
      <IntroCard />
    </div>
    
    <!-- Stats Section - Full Width -->
    <div class="col-span-1 md:col-span-2 lg:col-span-4 animate-delay-100" data-animate>
      <StatsCard />
    </div>
    
    <!-- About & Experience Row -->
    <div class="col-span-1 lg:col-span-2 animate-delay-200" data-animate>
      <AboutMe />
    </div>
    <div class="col-span-1 animate-delay-300" data-animate>
      <ExperienceCard />
    </div>
    <div class="col-span-1 animate-delay-400" data-animate>
      <CVCard />
    </div>
    
    <!-- Skills & Tech Stack Row -->
    <div class="col-span-1 md:col-span-2 lg:col-span-2 animate-delay-100" data-animate>
      <MyStack />
    </div>
    <div class="col-span-1 md:col-span-2 lg:col-span-2 animate-delay-200" data-animate>
      <SkillsVisualization />
    </div>
    
    <!-- Projects Full Width -->
    <div class="col-span-1 md:col-span-2 lg:col-span-4 animate-delay-300" data-animate>
      <ProjectsCard />
    </div>
    
    <!-- Achievements & Certifications Row -->
    <div class="col-span-1 animate-delay-100" data-animate>
      <AchievementsCard />
    </div>
    <div class="col-span-1 animate-delay-200" data-animate>
      <CertificationsCard />
    </div>
    <div class="col-span-1 animate-delay-300" data-animate>
      <StudyCard />
    </div>
    <div class="col-span-1 animate-delay-400" data-animate>
      <TimeZoneCard />
    </div>
    
    <!-- Philosophy Section -->
    <div class="col-span-1 md:col-span-2 lg:col-span-4 animate-delay-100" data-animate>
      <PhilosophyCard />
    </div>
    
    <!-- Contact & Additional Info Row -->
    <div class="col-span-1 animate-delay-200" data-animate>
      <ContactsCard />
    </div>
    <div class="col-span-1 animate-delay-300" data-animate>
      <Card
        colSpan="col-span-1"
        title="Blog & Insights"
        href="https://mranv.pages.dev"
      />
    </div>
    <div class="col-span-1 md:col-span-2 animate-delay-400" data-animate>
      <Now />
    </div>
  </main>
</BaseLayout>

<script>
  // Enhanced loader with smooth transition
  window.addEventListener('load', () => {
    const loader = document.getElementById('loader')
    loader.style.opacity = '0'
    setTimeout(() => {
      loader.style.display = 'none'
    }, 500)
  })
</script>